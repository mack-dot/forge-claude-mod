#!/bin/busybox.static sh
# /init of the forge vfkit agent VM: the host's virtio-rng seeds the kernel's random pool first
# (Python blocks in getrandom() until it is seeded: about 1-4 s without it), then boxinit.py.
/bin/busybox.static mount -t proc proc /proc
/bin/busybox.static mount -t devtmpfs dev /dev
/bin/busybox.static insmod /lib/modules/forge/0-rng-core.ko
/bin/busybox.static insmod /lib/modules/forge/1-virtio-rng.ko
/bin/busybox.static --install -s 2>/dev/null
exec /usr/bin/python3 -I -S /forge-guest/boxinit.py
