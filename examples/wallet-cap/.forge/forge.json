{
  "version": 1,
  "checks": [
    {
      "name": "wallet-cap",
      "spec": "spec/WalletSpec.dfy",
      "files": [
        "impl/Wallet.dfy"
      ],
      "binding": {
        "file": "impl/Wallet.dfy",
        "prefix": "include \"../spec/WalletSpec.dfy\"\n\nmodule Wallet refines WalletSpec {"
      },
      "build": {
        "targets": [
          "py",
          "js",
          "go",
          "rs",
          "java"
        ],
        "out": "verified",
        "fuzz": "fuzz/WalletFuzz.dfy",
        "usedBy": [
          {
            "file": "app.py",
            "contains": "'verified', 'wallet-cap', 'py', 'wallet_cap-py'"
          }
        ]
      },
      "examples": "spec/WalletExamples.dfy",
      "decisions": ".forge/decisions/wallet-cap.md",
      "diff": [
        {
          "lang": "py",
          "inputs": "diff/wallet_inputs.py",
          "adapter": "diff/wallet_diff.py",
          "watch": [
            "legacy_wallet.py",
            "app.py"
          ]
        },
        {
          "lang": "js",
          "inputs": "diff/wallet_inputs.py",
          "adapter": "diff/wallet_diff.mjs",
          "watch": [
            "legacy_wallet.ts"
          ]
        },
        {
          "lang": "go",
          "inputs": "diff/wallet_inputs.py",
          "adapter": "diff/wallet_diff.go",
          "watch": [
            "legacygo/legacy.go"
          ]
        },
        {
          "lang": "rs",
          "inputs": "diff/wallet_inputs.py",
          "adapter": "diff/wallet_diff.rs",
          "watch": [
            "legacy_wallet.rs"
          ]
        },
        {
          "lang": "java",
          "inputs": "diff/wallet_inputs.py",
          "adapter": "diff/wallet_diff.java",
          "java_sources": [
            "legacyjava"
          ],
          "watch": [
            "legacyjava/LegacyWallet.java"
          ]
        }
      ]
    }
  ]
}
